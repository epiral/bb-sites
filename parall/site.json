      "retry_safety": "safe_with_backoff",
      "max_concurrency": 1,
      "serialization_key": "site:parall:{profile}",
      "output_modes": ["legacy", "envelope_v1"],
      "timeout_class": "standard",
      "envelope_versions": ["pinix.site-result-envelope.v1"],
      "params": {}
    },
